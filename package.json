{
  "name": "misthustlers-merged-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "test": "vitest run",
    "test:unit": "vitest run src/utils",
    "test:e2e": "node scripts/e2e-test.mjs",
    "build": "npm run build:pages",
    "build:seo": "npx vite build --configLoader native && node scripts/prerender.mjs && node scripts/verify-seo.mjs",
    "build:netlify": "npx vite build --configLoader native && node scripts/prerender.mjs && node scripts/netlify-postbuild.mjs",
    "build:pages": "npx vite build --configLoader native && node scripts/prerender.mjs && node scripts/verify-seo.mjs && node scripts/pages-postbuild.mjs",
    "build:apps": "npm run build:netlify",
    "prerender": "node scripts/prerender.mjs",
    "verify-seo": "node scripts/verify-seo.mjs",
    "seo-check": "node scripts/seo-check.mjs",
    "leads:google": "node scripts/google-maps-leads.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "chromium-bidi": "0.5.17",
    "clsx": "2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.28.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.6.2",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "@vitest/coverage-v8": "^0.34.6",
    "happy-dom": "^20.11.1",
    "playwright": "^1.60.0",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^7.3.5",
    "vitest": "^0.34.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
