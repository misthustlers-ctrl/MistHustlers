generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Content {
  id        String   @id @default(uuid())
  page      String   @unique
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("content")
}

model ContentDraft {
  id        String   @id @default(uuid())
  page      String   @unique
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("content_drafts")
}

model ContentRevision {
  id        Int      @id @default(autoincrement())
  page      String
  data      Json
  action    String   @default("publish")
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([page])
  @@map("content_revisions")
}

model MediaAsset {
  id        Int      @id @default(autoincrement())
  url       String   @unique
  filename  String
  label     String?
  category  String?
  altText   String?  @map("alt_text")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("media_assets")
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  actor     String?
  role      String?
  action    String
  target    String?
  detail    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("activity_logs")
}

model Inquiry {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String
  company   String?
  service   String
  budget    String
  message   String
  status    String   @default("new")
  notes     String?
  emailStatus String @default("pending") @map("email_status")
  sheetStatus String @default("pending") @map("sheet_status")
  sheetError  String? @map("sheet_error")
  ownerId   Int?     @map("owner_id")
  acquisitionPartnerId Int? @map("acquisition_partner_id")
  affiliatePartnerId   Int? @map("affiliate_partner_id")
  assignedHrId Int?   @map("assigned_hr_id")
  leadSource String?  @map("lead_source")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner AdminUser? @relation("OwnedInquiries", fields: [ownerId], references: [id], onDelete: SetNull)
  acquisitionPartner AdminUser? @relation("AcquisitionPartnerInquiries", fields: [acquisitionPartnerId], references: [id], onDelete: SetNull)
  affiliatePartner AdminUser? @relation("AffiliatePartnerInquiries", fields: [affiliatePartnerId], references: [id], onDelete: SetNull)
  assignedHr AdminUser? @relation("AssignedHrInquiries", fields: [assignedHrId], references: [id], onDelete: SetNull)
  clientWorks ClientWork[]

  @@index([ownerId])
  @@index([acquisitionPartnerId])
  @@index([affiliatePartnerId])
  @@index([assignedHrId])
  @@map("inquiries")
}

model Opportunity {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  department  String
  type        String    @default("full-time")
  location    String?
  status      String    @default("open")
  applicants  Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  applicantsRel Applicant[]

  @@map("opportunities")
}

model Applicant {
  id            Int       @id @default(autoincrement())
  opportunityId Int       @map("opportunity_id")
  name          String
  email         String
  phone         String?
  resumeUrl     String?   @map("resume_url")
  coverLetter   String?   @map("cover_letter")
  status        String    @default("new")
  notes         String?
  assignedHrId  Int?      @map("assigned_hr_id")
  positionId    Int?      @map("position_id")
  applicationType String  @default("career") @map("application_type")
  currentStage  String    @default("new") @map("current_stage")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  assignedHr    AdminUser? @relation("AssignedHrApplicants", fields: [assignedHrId], references: [id], onDelete: SetNull)

  @@index([assignedHrId])
  @@index([positionId])
  @@map("applicants")
}

model Project {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  clientName  String?   @map("client_name")
  status      String    @default("planning")
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  acquisitionPartnerId Int? @map("acquisition_partner_id")
  deliveryPartnerId Int? @map("delivery_partner_id")
  affiliatePartnerId Int? @map("affiliate_partner_id")
  assignedHrId Int? @map("assigned_hr_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  acquisitionPartner AdminUser? @relation("AcquisitionPartnerProjects", fields: [acquisitionPartnerId], references: [id], onDelete: SetNull)
  deliveryPartner AdminUser? @relation("DeliveryPartnerProjects", fields: [deliveryPartnerId], references: [id], onDelete: SetNull)
  affiliatePartner AdminUser? @relation("AffiliatePartnerProjects", fields: [affiliatePartnerId], references: [id], onDelete: SetNull)
  assignedHr AdminUser? @relation("AssignedHrProjects", fields: [assignedHrId], references: [id], onDelete: SetNull)

  @@index([acquisitionPartnerId])
  @@index([deliveryPartnerId])
  @@index([affiliatePartnerId])
  @@index([assignedHrId])
  @@map("projects")
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  displayName  String?  @map("display_name")
  passwordHash String   @map("password_hash")
  salt         String
  role         String   @default("agent")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  agentWorks   ClientWork[] @relation("AgentWorks")
  partnerWorks ClientWork[] @relation("PartnerWorks")
  ownedInquiries Inquiry[] @relation("OwnedInquiries")
  acquisitionPartnerInquiries Inquiry[] @relation("AcquisitionPartnerInquiries")
  affiliatePartnerInquiries Inquiry[] @relation("AffiliatePartnerInquiries")
  assignedHrInquiries Inquiry[] @relation("AssignedHrInquiries")
  assignedHrApplicants Applicant[] @relation("AssignedHrApplicants")
  acquisitionPartnerProjects Project[] @relation("AcquisitionPartnerProjects")
  deliveryPartnerProjects Project[] @relation("DeliveryPartnerProjects")
  affiliatePartnerProjects Project[] @relation("AffiliatePartnerProjects")
  assignedHrProjects Project[] @relation("AssignedHrProjects")
  acquisitionPartnerWorks ClientWork[] @relation("AcquisitionPartnerWorks")
  deliveryPartnerWorks ClientWork[] @relation("DeliveryPartnerWorks")
  affiliatePartnerWorks ClientWork[] @relation("AffiliatePartnerWorks")
  assignedHrWorks ClientWork[] @relation("AssignedHrWorks")
  referralCodes ReferralCode[]
  partnerProfile PartnerProfile?

  @@map("admin_users")
}

model ClientWork {
  id              Int       @id @default(autoincrement())
  clientName      String    @map("client_name")
  clientPhone     String?   @map("client_phone")
  service         String
  price           Int       @default(0)
  status          String    @default("lead")
  notes           String?
  deliveryLink    String?   @map("delivery_link")
  deliveryNotes   String?   @map("delivery_notes")
  submittedAt     DateTime? @map("submitted_at")
  agentId         Int?      @map("agent_id")
  partnerId       Int?      @map("partner_id")
  inquiryId       Int?      @map("inquiry_id")
  acquisitionPartnerId Int? @map("acquisition_partner_id")
  deliveryPartnerId Int? @map("delivery_partner_id")
  affiliatePartnerId Int? @map("affiliate_partner_id")
  assignedHrId    Int?      @map("assigned_hr_id")
  agentCommission Int       @default(0) @map("agent_commission")
  agentPaid       Int       @default(0) @map("agent_paid")
  partnerPayout   Int       @default(0) @map("partner_payout")
  partnerPaid     Int       @default(0) @map("partner_paid")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  agent           AdminUser? @relation("AgentWorks", fields: [agentId], references: [id], onDelete: SetNull)
  partner         AdminUser? @relation("PartnerWorks", fields: [partnerId], references: [id], onDelete: SetNull)
  inquiry         Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  acquisitionPartner AdminUser? @relation("AcquisitionPartnerWorks", fields: [acquisitionPartnerId], references: [id], onDelete: SetNull)
  deliveryPartner AdminUser? @relation("DeliveryPartnerWorks", fields: [deliveryPartnerId], references: [id], onDelete: SetNull)
  affiliatePartner AdminUser? @relation("AffiliatePartnerWorks", fields: [affiliatePartnerId], references: [id], onDelete: SetNull)
  assignedHr      AdminUser? @relation("AssignedHrWorks", fields: [assignedHrId], references: [id], onDelete: SetNull)
  payments        WorkPayment[]

  @@index([agentId])
  @@index([partnerId])
  @@index([inquiryId])
  @@index([acquisitionPartnerId])
  @@index([deliveryPartnerId])
  @@index([affiliatePartnerId])
  @@index([assignedHrId])
  @@map("client_work")
}

model PartnerProfile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  partnerType String @map("partner_type")
  category  String?
  status    String   @default("active")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([partnerType])
  @@map("partner_profiles")
}

model ReferralCode {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  ownerId   Int      @map("owner_id")
  ownerRole String   @map("owner_role")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner AdminUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  events ReferralEvent[]
  attributions ReferralAttribution[]

  @@index([ownerId])
  @@map("referral_codes")
}

model ReferralEvent {
  id        Int      @id @default(autoincrement())
  referralCodeId Int @map("referral_code_id")
  eventType String  @map("event_type")
  path      String?
  ipHash    String? @map("ip_hash")
  userAgent String? @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)

  @@index([referralCodeId])
  @@map("referral_events")
}

model ReferralAttribution {
  id        Int      @id @default(autoincrement())
  referralCodeId Int @map("referral_code_id")
  targetType String @map("target_type")
  targetId   Int    @map("target_id")
  status     String @default("pending")
  createdAt DateTime @default(now()) @map("created_at")

  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)

  @@index([referralCodeId])
  @@index([targetType, targetId])
  @@map("referral_attributions")
}

model WorkPayment {
  id        Int      @id @default(autoincrement())
  workId    Int      @map("work_id")
  role      String
  amount    Int      @default(0)
  note      String?
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  work      ClientWork @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId])
  @@map("work_payments")
}
