generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Content {
  id        String   @id @default(uuid())
  page      String   @unique
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("content")
}

model ContentDraft {
  id        String   @id @default(uuid())
  page      String   @unique
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("content_drafts")
}

model ContentRevision {
  id        Int      @id @default(autoincrement())
  page      String
  data      Json
  action    String   @default("publish")
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([page])
  @@map("content_revisions")
}

model MediaAsset {
  id        Int      @id @default(autoincrement())
  url       String   @unique
  filename  String
  label     String?
  category  String?
  altText   String?  @map("alt_text")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("media_assets")
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  actor     String?
  role      String?
  action    String
  target    String?
  detail    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("activity_logs")
}

model Inquiry {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String
  company   String?
  service   String
  budget    String
  message   String
  status    String   @default("new")
  notes     String?
  emailStatus String @default("pending") @map("email_status")
  sheetStatus String @default("pending") @map("sheet_status")
  sheetError  String? @map("sheet_error")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("inquiries")
}

model Opportunity {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  department  String
  type        String    @default("full-time")
  location    String?
  status      String    @default("open")
  applicants  Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  applicantsRel Applicant[]

  @@map("opportunities")
}

model Applicant {
  id            Int       @id @default(autoincrement())
  opportunityId Int       @map("opportunity_id")
  name          String
  email         String
  phone         String?
  resumeUrl     String?   @map("resume_url")
  coverLetter   String?   @map("cover_letter")
  status        String    @default("new")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("applicants")
}

model Project {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  clientName  String?   @map("client_name")
  status      String    @default("planning")
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("projects")
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  displayName  String?  @map("display_name")
  passwordHash String   @map("password_hash")
  salt         String
  role         String   @default("agent")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  agentWorks   ClientWork[] @relation("AgentWorks")
  partnerWorks ClientWork[] @relation("PartnerWorks")

  @@map("admin_users")
}

model ClientWork {
  id              Int       @id @default(autoincrement())
  clientName      String    @map("client_name")
  clientPhone     String?   @map("client_phone")
  service         String
  price           Int       @default(0)
  status          String    @default("lead")
  notes           String?
  deliveryLink    String?   @map("delivery_link")
  deliveryNotes   String?   @map("delivery_notes")
  submittedAt     DateTime? @map("submitted_at")
  agentId         Int?      @map("agent_id")
  partnerId       Int?      @map("partner_id")
  agentCommission Int       @default(0) @map("agent_commission")
  agentPaid       Int       @default(0) @map("agent_paid")
  partnerPayout   Int       @default(0) @map("partner_payout")
  partnerPaid     Int       @default(0) @map("partner_paid")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  agent           AdminUser? @relation("AgentWorks", fields: [agentId], references: [id], onDelete: SetNull)
  partner         AdminUser? @relation("PartnerWorks", fields: [partnerId], references: [id], onDelete: SetNull)
  payments        WorkPayment[]

  @@index([agentId])
  @@index([partnerId])
  @@map("client_work")
}

model WorkPayment {
  id        Int      @id @default(autoincrement())
  workId    Int      @map("work_id")
  role      String
  amount    Int      @default(0)
  note      String?
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  work      ClientWork @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId])
  @@map("work_payments")
}
