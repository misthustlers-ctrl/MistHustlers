generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Content {
  id        String   @id @default(uuid())
  page      String   @unique
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("content")
}

model ContentDraft {
  id        String   @id @default(uuid())
  page      String   @unique
  data      Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("content_drafts")
}

model ContentRevision {
  id        Int      @id @default(autoincrement())
  page      String
  data      Json
  action    String   @default("publish")
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([page])
  @@map("content_revisions")
}

model MediaAsset {
  id        Int      @id @default(autoincrement())
  url       String   @unique
  filename  String
  label     String?
  category  String?
  altText   String?  @map("alt_text")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("media_assets")
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  actor     String?
  role      String?
  action    String
  target    String?
  detail    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("activity_logs")
}

model Inquiry {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String
  company   String?
  service   String
  budget    String
  message   String
  status    String   @default("new")
  notes     String?
  emailStatus String @default("pending") @map("email_status")
  sheetStatus String @default("pending") @map("sheet_status")
  sheetError  String? @map("sheet_error")
  ownerId   Int?     @map("owner_id")
  acquisitionPartnerId Int? @map("acquisition_partner_id")
  affiliatePartnerId   Int? @map("affiliate_partner_id")
  assignedHrId Int?   @map("assigned_hr_id")
  leadSource String?  @map("lead_source")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner AdminUser? @relation("OwnedInquiries", fields: [ownerId], references: [id], onDelete: SetNull)
  acquisitionPartner AdminUser? @relation("AcquisitionPartnerInquiries", fields: [acquisitionPartnerId], references: [id], onDelete: SetNull)
  affiliatePartner AdminUser? @relation("AffiliatePartnerInquiries", fields: [affiliatePartnerId], references: [id], onDelete: SetNull)
  assignedHr AdminUser? @relation("AssignedHrInquiries", fields: [assignedHrId], references: [id], onDelete: SetNull)
  clientWorks ClientWork[]

  @@index([ownerId])
  @@index([acquisitionPartnerId])
  @@index([affiliatePartnerId])
  @@index([assignedHrId])
  @@map("inquiries")
}

model Opportunity {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  department  String
  type        String    @default("full-time")
  location    String?
  status      String    @default("open")
  applicants  Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  applicantsRel Applicant[]

  @@map("opportunities")
}

model Applicant {
  id            Int       @id @default(autoincrement())
  opportunityId Int       @map("opportunity_id")
  name          String
  email         String
  phone         String?
  resumeUrl     String?   @map("resume_url")
  coverLetter   String?   @map("cover_letter")
  status        String    @default("new")
  notes         String?
  assignedHrId  Int?      @map("assigned_hr_id")
  positionId    Int?      @map("position_id")
  applicationType String  @default("career") @map("application_type")
  currentStage  String    @default("new") @map("current_stage")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  assignedHr    AdminUser? @relation("AssignedHrApplicants", fields: [assignedHrId], references: [id], onDelete: SetNull)

  @@index([assignedHrId])
  @@index([positionId])
  @@map("applicants")
}

model Project {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  clientName  String?   @map("client_name")
  status      String    @default("planning")
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  acquisitionPartnerId Int? @map("acquisition_partner_id")
  deliveryPartnerId Int? @map("delivery_partner_id")
  affiliatePartnerId Int? @map("affiliate_partner_id")
  assignedHrId Int? @map("assigned_hr_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  acquisitionPartner AdminUser? @relation("AcquisitionPartnerProjects", fields: [acquisitionPartnerId], references: [id], onDelete: SetNull)
  deliveryPartner AdminUser? @relation("DeliveryPartnerProjects", fields: [deliveryPartnerId], references: [id], onDelete: SetNull)
  affiliatePartner AdminUser? @relation("AffiliatePartnerProjects", fields: [affiliatePartnerId], references: [id], onDelete: SetNull)
  assignedHr AdminUser? @relation("AssignedHrProjects", fields: [assignedHrId], references: [id], onDelete: SetNull)

  @@index([acquisitionPartnerId])
  @@index([deliveryPartnerId])
  @@index([affiliatePartnerId])
  @@index([assignedHrId])
  @@map("projects")
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  displayName  String?  @map("display_name")
  passwordHash String   @map("password_hash")
  salt         String
  role         String   @default("agent")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  agentWorks   ClientWork[] @relation("AgentWorks")
  partnerWorks ClientWork[] @relation("PartnerWorks")
  ownedInquiries Inquiry[] @relation("OwnedInquiries")
  acquisitionPartnerInquiries Inquiry[] @relation("AcquisitionPartnerInquiries")
  affiliatePartnerInquiries Inquiry[] @relation("AffiliatePartnerInquiries")
  assignedHrInquiries Inquiry[] @relation("AssignedHrInquiries")
  assignedHrApplicants Applicant[] @relation("AssignedHrApplicants")
  acquisitionPartnerProjects Project[] @relation("AcquisitionPartnerProjects")
  deliveryPartnerProjects Project[] @relation("DeliveryPartnerProjects")
  affiliatePartnerProjects Project[] @relation("AffiliatePartnerProjects")
  assignedHrProjects Project[] @relation("AssignedHrProjects")
  acquisitionPartnerWorks ClientWork[] @relation("AcquisitionPartnerWorks")
  deliveryPartnerWorks ClientWork[] @relation("DeliveryPartnerWorks")
  affiliatePartnerWorks ClientWork[] @relation("AffiliatePartnerWorks")
  assignedHrWorks ClientWork[] @relation("AssignedHrWorks")
  referralCodes ReferralCode[]
  partnerProfile PartnerProfile?

  @@map("admin_users")
}

model ClientWork {
  id              Int       @id @default(autoincrement())
  clientName      String    @map("client_name")
  clientPhone     String?   @map("client_phone")
  service         String
  price           Int       @default(0)
  status          String    @default("lead")
  notes           String?
  deliveryLink    String?   @map("delivery_link")
  deliveryNotes   String?   @map("delivery_notes")
  submittedAt     DateTime? @map("submitted_at")
  agentId         Int?      @map("agent_id")
  partnerId       Int?      @map("partner_id")
  inquiryId       Int?      @map("inquiry_id")
  acquisitionPartnerId Int? @map("acquisition_partner_id")
  deliveryPartnerId Int? @map("delivery_partner_id")
  affiliatePartnerId Int? @map("affiliate_partner_id")
  assignedHrId    Int?      @map("assigned_hr_id")
  agentCommission Int       @default(0) @map("agent_commission")
  agentPaid       Int       @default(0) @map("agent_paid")
  partnerPayout   Int       @default(0) @map("partner_payout")
  partnerPaid     Int       @default(0) @map("partner_paid")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  agent           AdminUser? @relation("AgentWorks", fields: [agentId], references: [id], onDelete: SetNull)
  partner         AdminUser? @relation("PartnerWorks", fields: [partnerId], references: [id], onDelete: SetNull)
  inquiry         Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  acquisitionPartner AdminUser? @relation("AcquisitionPartnerWorks", fields: [acquisitionPartnerId], references: [id], onDelete: SetNull)
  deliveryPartner AdminUser? @relation("DeliveryPartnerWorks", fields: [deliveryPartnerId], references: [id], onDelete: SetNull)
  affiliatePartner AdminUser? @relation("AffiliatePartnerWorks", fields: [affiliatePartnerId], references: [id], onDelete: SetNull)
  assignedHr      AdminUser? @relation("AssignedHrWorks", fields: [assignedHrId], references: [id], onDelete: SetNull)
  payments        WorkPayment[]

  @@index([agentId])
  @@index([partnerId])
  @@index([inquiryId])
  @@index([acquisitionPartnerId])
  @@index([deliveryPartnerId])
  @@index([affiliatePartnerId])
  @@index([assignedHrId])
  @@map("client_work")
}

model PartnerProfile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  partnerType String @map("partner_type")
  category  String?
  status    String   @default("active")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([partnerType])
  @@map("partner_profiles")
}

model ReferralCode {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  ownerId   Int      @map("owner_id")
  ownerRole String   @map("owner_role")
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner AdminUser @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  events ReferralEvent[]
  attributions ReferralAttribution[]

  @@index([ownerId])
  @@map("referral_codes")
}

model ReferralEvent {
  id        Int      @id @default(autoincrement())
  referralCodeId Int @map("referral_code_id")
  eventType String  @map("event_type")
  path      String?
  ipHash    String? @map("ip_hash")
  userAgent String? @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)

  @@index([referralCodeId])
  @@map("referral_events")
}

model ReferralAttribution {
  id        Int      @id @default(autoincrement())
  referralCodeId Int @map("referral_code_id")
  targetType String @map("target_type")
  targetId   Int    @map("target_id")
  status     String @default("pending")
  createdAt DateTime @default(now()) @map("created_at")

  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)

  @@index([referralCodeId])
  @@index([targetType, targetId])
  @@map("referral_attributions")
}

model WorkPayment {
  id        Int      @id @default(autoincrement())
  workId    Int      @map("work_id")
  role      String
  amount    Int      @default(0)
  note      String?
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  work      ClientWork @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([workId])
  @@map("work_payments")
}

model KnowledgeItem {
  id              Int      @id @default(autoincrement())
  source          String
  sourceId        String?  @map("source_id")
  category        String
  subcategory     String?
  key             String
  value           String
  version         Int      @default(1)
  hash            String
  verificationStatus String @default("verified") @map("verification_status")
  riskLevel       String   @default("low") @map("risk_level")
  requiresApproval Boolean @default(false) @map("requires_approval")
  approvalStatus  String   @default("approved") @map("approval_status")
  publishedAt     DateTime? @map("published_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([source, sourceId, key])
  @@index([category])
  @@index([approvalStatus])
  @@map("knowledge_items")
}

model ChatbotConfig {
  id                  Int      @id @default(autoincrement())
  enabled             Boolean  @default(true)
  greeting            String   @default("Hi, I'm ARIA — MistHustlers' Senior Sales Consultant. I'm here to understand your business and help you find the right digital solution. Before I recommend anything, I'd like to understand your current situation. What does your business do?")
  greetingHindi       String   @default("नमस्ते, मैं ARIA हूँ — MistHustlers की Senior Sales Consultant। मैं आपके व्यवसाय को समझने और सही डिजिटल समाधान ढूंढने में आपकी मदद करने के लिए यहाँ हूँ। कुछ भी सुझाने से पहले, मैं आपकी मौजूदा स्थिति समझना चाहूँगी। आपका व्यवसाय क्या करता है?") @map("greeting_hindi")
  greetingHinglish    String   @default("Namaste, main ARIA hoon — MistHustlers ki Senior Sales Consultant. Main aapke business ko samajhne aur sahi digital solution dhundhne mein aapki madad karne ke liye yahan hoon. Kuch bhi suggest karne se pehle, main aapki current situation samajhna chahungi. Aapka business kya karta hai?") @map("greeting_hinglish")
  primaryColor        String   @default("#fc5000") @map("primary_color")
  position            String   @default("bottom-right")
  maxMessageLength    Int      @default(2000) @map("max_message_length")
  sessionTtlMinutes   Int      @default(4320) @map("session_ttl_minutes")
  responseTone        String   @default("consultative") @map("response_tone")
  salesInstructions   String   @default("Ask one useful question at a time. Recommend only verified services and prices. Never invent guarantees, discounts or delivery dates.") @map("sales_instructions")
  solutionInstructions String  @default("After a service is selected, understand the business and recommend a tailored blueprint with priorities, integrations, automation opportunities, phased scope, and clear reasoning.") @map("solution_instructions")
  unknownAnswer       String   @default("I do not have a verified answer for that yet. Please use the visible green WhatsApp button to send your inquiry to the MistHustlers team.") @map("unknown_answer")
  generativeEnabled   Boolean  @default(true) @map("generative_enabled")
  opencodeModel       String   @default("deepseek-v4-flash-free") @map("opencode_model")
  opencodeApiKeyEncrypted String? @map("opencode_api_key_encrypted")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("chatbot_config")
}

model ChatSession {
  id             Int      @id @default(autoincrement())
  token          String   @unique
  language       String   @default("en")
  languageSource String   @default("auto") @map("language_source")
  state          String   @default("greeting")
  stateData      Json     @default("{}") @map("state_data")
  leadId         Int?     @map("lead_id")
  isActive       Boolean  @default(true) @map("is_active")
  messageCount   Int      @default(0) @map("message_count")
  expiresAt      DateTime @map("expires_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  messages   ChatMessage[]
  qualifiedLead QualifiedLead? @relation("QualifiedLeadSession")

  @@index([token])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  sessionId  Int      @map("session_id")
  role       String
  content    String
  detectedLanguage String? @map("detected_language")
  metadata   Json?    @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model QualifiedLead {
  id                Int      @id @default(autoincrement())
  sessionId         Int?     @unique @map("session_id")
  name              String?
  email             String?
  phone             String?
  company           String?
  businessType      String?  @map("business_type")
  industry          String?
  goal              String?
  budget            String?
  timeline          String?
  serviceInterest   String?  @map("service_interest")
  features          String?
  leadScore         Int      @default(0) @map("lead_score")
  leadCategory      String   @default("nurture") @map("lead_category")
  consentGiven      Boolean  @default(false) @map("consent_given")
  consentAt         DateTime? @map("consent_at")
  status            String   @default("new")
  notes             String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  session ChatSession? @relation("QualifiedLeadSession", fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([leadCategory])
  @@index([status])
  @@map("qualified_leads")
}

model KnowledgeSyncRun {
  id          Int      @id @default(autoincrement())
  status      String   @default("running")
  source      String?
  itemsTotal  Int      @default(0) @map("items_total")
  itemsAdded  Int      @default(0) @map("items_added")
  itemsUpdated Int     @default(0) @map("items_updated")
  itemsFailed Int      @default(0) @map("items_failed")
  errorLog    Json?    @default("[]") @map("error_log")
  startedAt   DateTime @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  @@map("knowledge_sync_runs")
}
