# Railway variables
# Add these in Railway -> your app service -> Variables.

# Required: Railway PostgreSQL reference
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Required: owner admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# Recommended: long random string for signed admin sessions
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Optional: set after Railway gives you a domain.
# If frontend and backend are same Railway service, same-origin requests work.
CORS_ORIGIN=https://your-app.up.railway.app

# Optional: email delivery. Without these, emails are logged/skipped.
SMTP_EMAIL=
SMTP_PASSWORD=
EMAIL_TO=
