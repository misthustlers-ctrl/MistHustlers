# Copy to .env for local/AWS use. Never commit the real .env file.

# Supabase PostgreSQL connection string. Do not commit the real value.
DATABASE_URL="postgresql://postgres:replace-with-supabase-password@db.your-project.supabase.co:5432/postgres?schema=public"

# Required: owner admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# Recommended: long random string for signed admin sessions
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Public frontend URL used for SEO/canonical references.
SITE_URL=https://www.misthustlers.in
PUBLIC_SITE_URL=https://www.misthustlers.in
VITE_SITE_URL=https://www.misthustlers.in

# Public origins allowed to call the API.
CORS_ORIGIN=https://www.misthustlers.in,http://localhost:5173

# Persistent media directory. Relative paths are resolved from backend/.
UPLOAD_DIR=uploads

# Express listens only on localhost; Cloudflare Tunnel provides public HTTPS.
PORT=3000
HOST=127.0.0.1

# Trust only the local Cloudflare Tunnel proxy on AWS.
TRUST_PROXY=loopback

# Optional: least-privilege Cloudflare token with Zone.Cache Purge permission.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Optional: email delivery. Without these, emails are logged/skipped.
SMTP_EMAIL=
SMTP_PASSWORD=
EMAIL_TO=

# Optional: Google Sheet sync for website form submissions.
# Use a Google Apps Script Web App URL that accepts POST JSON.
GOOGLE_SHEETS_WEBHOOK_URL=

# Optional: conversational AI fallback through OpenCode Zen.
# Create the key at https://opencode.ai/auth. Keep it server-side only.
OPENCODE_API_KEY=
OPENCODE_MODEL=deepseek-v4-flash-free

# Recommended when saving the OpenCode key from Admin. Keep this stable.
# Generate a long random value; changing it makes previously saved keys unreadable.
CHATBOT_KEY_ENCRYPTION_SECRET=
